# Copy to .env and fill in. Lines starting with # are ignored.
# Do NOT commit .env - it holds proxy credentials, the iCloud password
# and the admin password.

# ---- account pool ----------------------------------------------------------
OASIS_DB=/data/oasis.db

# Optional: credential file imported at boot. Put it in ./data and point here.
#   iCloud:    别名@icloud.com----acc_xxxxxxxx----hme
#   Microsoft: user@outlook.com----password----client_id----refresh_token
#   Gmail:     user@gmail.com----password----client_id----client_secret----refresh_token
# OASIS_IMPORT=/data/creds.txt

# ---- proxies ---------------------------------------------------------------
# Newline- or comma-separated. http(s):// and socks5:// both work.
OASIS_PROXIES=socks5://user:pass@PROXY_HOST:PROXY_PORT

# Optional local proxy every upstream is dialled through. 127.0.0.1 inside the
# container is the container itself - use host.docker.internal for a proxy on
# the Docker host.
# OASIS_FRONT_PROXY=socks5://host.docker.internal:10808

# REQUIRED for browser/hybrid mode: an egress that can reach Google. reCAPTCHA
# lives there, and without it the browser stalls on wait_for_function.
OASIS_GOOGLE_PROXY=http://host.docker.internal:10808

# Mailbox fetches go direct by default; set this only if that is blocked.
# OASIS_MAIL_PROXY=

# ---- iCloud Hide-My-Email --------------------------------------------------
# The HME service runs on the host, so from inside the container it is
# host.docker.internal, NOT 127.0.0.1. Add
#   extra_hosts: ["host.docker.internal:host-gateway"]
# to docker-compose.yml if your Docker is older and the name does not resolve.
OASIS_HME_BASE=http://host.docker.internal:8081
OASIS_HME_PASSWORD=change-me

# ---- 管理界面 ---------------------------------------------------------------
# 必填。界面能启停引擎、看到账号池、导出凭据，所以不设密码服务会直接拒绝启动
# （不是"裸奔"，是根本不起）。
OASIS_WEB_PASSWORD=change-me-too

# 运行时可调项（线程数、模式、场次、超时等）会写进这个文件，网页上改了就落盘。
# 默认放在数据库同目录，跟着 volume 一起持久化。
# OASIS_CONFIG=/data/oasis_config.json

# ---- 运行形态 ---------------------------------------------------------------
OASIS_MODE=browser
# 留空则按本机内存和核数自动推荐。2 vCPU / 3GB 上算出来是 2。
# iCloud 每小时只允许建约 10 个别名，2 线程足够。
# OASIS_THREADS=1
OASIS_SHOWS=glasgow,manchester,paris
OASIS_LINK_TIMEOUT=240
# 页面已经是主证据（浏览器模式不发成功邮件），邮件只作加分项：页面确认后最多
# 再看 30 秒；只有页面没确认时才会等满 OASIS_SUCCESS_TIMEOUT。
OASIS_VERIFY_SUCCESS=1
OASIS_SUCCESS_TIMEOUT=180
OASIS_PORT=8080
OASIS_IDLE=30
